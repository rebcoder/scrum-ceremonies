.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Node
node_modules/
frontend/node_modules/
.npm/

# Frontend build output (frontend/scripts/build.js writes it; never committed)
frontend/dist/
*.min.js
*.min.css
# ...except the self-hosted third-party libraries, which are committed source of
# truth. Provenance + SHA-256 for each file: frontend/v1/vendor/README.md
!frontend/v1/vendor/*.min.js
frontend/lighthouse-report*.json

# Local-only config (dev-up.sh writes config.local.js; deploys use config.js defaults)
.env
.env.local
frontend/config.local.js
frontend/v1/config.local.js

# Playwright output
test-results/
playwright-report/

# Generated performance results (scripts/ws-stress-test.js writes here)
docs/performance/

# Local screenshot scratch from manual UX audits
ux-audit-screenshots/

# Knowledge-graph outputs (per-session, large)
graphify-out/
graphify-out-*/

# Agent instruction files and Claude Code overrides stay local; they are not part of the public repo
CLAUDE.md
AGENTS.md
.claude/settings.local.json
.claude/scheduled_tasks.lock
