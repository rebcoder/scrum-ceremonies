release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Java
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# Logs (dev-up.sh writes per-process logs to .dev-logs/)
*.log
.dev-logs/

